# Keep this file free of real secrets. On the server, set these as runtime environment variables.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
# Use the official endpoint unless an approved internal gateway is configured.
DEEPSEEK_BASE_URL=https://api.deepseek.com
# SQLite lives in the named Docker volume at this path.
DATABASE_PATH=/data/career.db
# Set true only when the public site is served over HTTPS.
COOKIE_SECURE=false
# Comma-separated teacher accounts approved by the institution. Do not let users self-select this role.
CAREER_TEACHER_EMAILS=
# Production defaults to invite-only registration. List approved pilot accounts here.
REGISTRATION_MODE=invite
CAREER_INVITED_EMAILS=
# Local accounts remain active until YNU provides real OIDC parameters. Do not claim SSO without them.
IDENTITY_PROVIDER=local
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
